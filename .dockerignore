# The image build sees only what the Dockerfile copies: sources and lockfiles.
# Everything else — build output, node_modules, local data, .git — stays out.
**
!Cargo.toml
!Cargo.lock
!engine/**
!server/**
!cli/**
!docs/**
!src-tauri/Cargo.toml
!experiments/**
!src/**
!public/**
!index.html
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.node.json
!vite.config.ts
!CHANGELOG.md
!scripts/docs.mjs
!scripts/lib.mjs
# The documentation's local build and cache: the image builds its own.
docs/.vitepress/cache/
docs/.vitepress/dist/
