{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Signal Lab",
  "version": "../package.json",
  "identifier": "studio.proanima.signallab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/cli-bundle.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Signal Lab — ProAnimaStudio",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExMzVGMERBQTAzNTY3RDQKUldUVVp6V2cydkExb1htSTNMeDd4NVhOSDErSlZRVDRyTHFYM2JCODlTazlsSEZuVjh0MHcwQVMK",
      "endpoints": [
        "https://hub.proanima.net/v1/signal-lab/update/{{target}}/{{arch}}/{{current_version}}",
        "https://github.com/ProAnima/SignalLab/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "ProAnimaStudio",
    "homepage": "https://github.com/ProAnima/SignalLab",
    "copyright": "Copyright (c) 2026 ProAnimaStudio",
    "category": "DeveloperTool",
    "shortDescription": "OSC & network protocol simulator",
    "longDescription": "Signal Lab generates, captures and impairs the traffic show-control gear speaks: OSC over UDP, broadcast and multicast discovery, HTTP, and raw UDP/TCP load. Built for bringing an installation up before the installation exists.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "headerImage": "installer/nsis-header.bmp",
        "uninstallerHeaderImage": "installer/nsis-header.bmp",
        "installerHooks": "installer/hooks.nsh"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp",
        "fragmentPaths": ["installer/cli.wxs"],
        "componentRefs": ["SignalLabCommandLine"]
      }
    },
    "linux": {
      "deb": {
        "files": { "/usr/bin/signallab": "../target/release/signallab" }
      },
      "rpm": {
        "files": { "/usr/bin/signallab": "../target/release/signallab" }
      }
    }
  }
}
