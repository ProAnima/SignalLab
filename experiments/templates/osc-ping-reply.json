{
  "version": 4,
  "name": "OSC ping → reply",
  "params": [
    { "name": "device", "value": "127.0.0.1:9000" }
  ],
  "profiles": [],
  "profile": null,
  "seed": null,
  "nodes": [
    { "id": "start", "type": "start", "x": 40, "y": 110 },
    { "id": "ping", "type": "osc", "x": 260, "y": 110,
      "target": "{{device}}", "address": "/ping", "args": [{ "type": "str", "value": "{{run.id}}" }] },
    { "id": "pong", "type": "wait_osc", "x": 490, "y": 110,
      "bind": "127.0.0.1:9001", "address": "/pong",
      "args": [{ "index": 0, "op": "eq", "value": "{{run.id}}" }],
      "timeout_ms": 2000, "variable": "reply" },
    { "id": "answered", "type": "log", "x": 720, "y": 40,
      "message": "{{reply.address}} from {{reply.from}} in {{reply.ms}} ms" },
    { "id": "silent", "type": "log", "x": 720, "y": 190,
      "message": "No /pong from {{device}} within 2 s" },
    { "id": "end", "type": "end", "x": 950, "y": 110 }
  ],
  "edges": [
    { "from": "start", "to": "ping", "port": "next" },
    { "from": "ping", "to": "pong", "port": "next" },
    { "from": "pong", "to": "answered", "port": "matched" },
    { "from": "pong", "to": "silent", "port": "timeout" },
    { "from": "answered", "to": "end", "port": "next" },
    { "from": "silent", "to": "end", "port": "next" }
  ]
}
