{
  "version": 9,
  "name": "WebSocket echo",
  "params": [
    { "name": "service", "value": "ws://127.0.0.1:9001/echo" }
  ],
  "profiles": [],
  "profile": null,
  "seed": null,
  "nodes": [
    { "id": "start", "type": "start", "x": 40, "y": 110 },
    { "id": "socket", "type": "ws_connect", "x": 260, "y": 110,
      "url": "{{service}}", "headers": [], "protocols": [], "timeout_ms": 5000 },
    { "id": "ping", "type": "ws_send", "x": 490, "y": 110,
      "connection": "socket", "text": "{\"type\":\"ping\",\"run\":\"{{run.id}}\"}", "binary": false },
    { "id": "echo", "type": "wait_ws", "x": 720, "y": 110,
      "connection": "socket", "mode": "contains", "pattern": "\"run\":\"{{run.id}}\"",
      "timeout_ms": 3000, "variable": "echo" },
    { "id": "same", "type": "assert_value", "x": 950, "y": 40,
      "value": "{{echo.json.type}}", "op": "eq", "expected": "ping" },
    { "id": "silent", "type": "log", "x": 950, "y": 190,
      "message": "No echo from {{service}} within 3 s" },
    { "id": "bye", "type": "ws_close", "x": 1180, "y": 110,
      "connection": "socket", "code": 1000, "reason": "done" },
    { "id": "end", "type": "end", "x": 1410, "y": 110 }
  ],
  "edges": [
    { "from": "start", "to": "socket", "port": "next" },
    { "from": "socket", "to": "ping", "port": "next" },
    { "from": "ping", "to": "echo", "port": "next" },
    { "from": "echo", "to": "same", "port": "matched" },
    { "from": "echo", "to": "silent", "port": "timeout" },
    { "from": "same", "to": "bye", "port": "next" },
    { "from": "silent", "to": "bye", "port": "next" },
    { "from": "bye", "to": "end", "port": "next" }
  ]
}
