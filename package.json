{
  "name": "signal-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/docs.mjs build",
    "docs:dev": "node scripts/docs.mjs dev",
    "docs:build": "node scripts/docs.mjs build",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "check:linux": "node scripts/linux.mjs check",
    "build:linux": "node scripts/linux.mjs build",
    "clean:linux": "node scripts/linux.mjs clean",
    "check:image": "node scripts/image.mjs check",
    "check:webkit": "node scripts/webkit.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:linux": "node scripts/e2e.mjs --linux",
    "release": "node scripts/release.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "flag-icons": "^7.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~7.0.2",
    "vite": "^7.0.4",
    "vitepress": "^1.6.4"
  }
